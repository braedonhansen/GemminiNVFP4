index 00000000..4b1b8b5b
--- /dev/null
+++ b/src/main/scala/gemmini/NvFp4MeshAdapter.scala
@@ -0,0 +1,50 @@
+package gemmini
+
+import chisel3._
+import chisel3.util._
+
+/** NVFP4 mesh with the same port list as `Mesh` (M6.3 Phase B, option (iii): NVFP4-only config).
+  *
+  * Wraps the verified `NvFp4Mesh` (exact 13-bit integer column sums, V6 PEs; ported unchanged from hw/nvfp4pe) and adds
+  * the sidebands the standalone mesh does not carry:
+  *  - `in_id` / `in_last` are delayed by `meshRows * (tile_latency + 1)` like the per-tile ShiftRegister chain in Mesh.scala
+  *    (the same latency NvFp4Mesh gives `valid`), then by `output_delay`, like Mesh.scala's bottom-row output registers.
+  *  - `out_b` / `out_valid` get the same `output_delay` registers as Mesh.scala.
+  *  - Not modelled (WS only, 1x1 tiles): `in_control.shift/dataflow` (ignored), `out_c`, `out_control` (tied off).
+  *
+  * Data format: the mesh output word of a column is `outputType` (a 64-bit container here): 4 lanes, each the exact int13 column sum
+  * sign-extended to 16 bits, lane k = act(k/2) x wei(k%2), lane 0 in bits 15:0. In `in_b` the same container is accepted.
+  */
+class NvFp4MeshAdapter[T <: Data : Arithmetic](inputType: T, weightType: T, outputType: T, accType: T,
+                                               df: Dataflow.Value, tile_latency: Int,
+                                               max_simultaneous_matmuls: Int, output_delay: Int,
+                                               tileRows: Int, tileColumns: Int,
+                                               meshRows: Int, meshColumns: Int)
+  extends MeshModule(inputType, weightType, outputType, accType, df, max_simultaneous_matmuls,
+    tileRows, tileColumns, meshRows, meshColumns) {
+
+  require(tileRows == 1 && tileColumns == 1 && meshRows == meshColumns, "NVFP4 mesh: 1x1 tiles, square mesh")
+  require(outputType.getWidth == 64, s"NVFP4 mesh output container must be 4 x 16 bits, got ${outputType.getWidth}")
+  require(inputType.getWidth == 8 && weightType.getWidth == 8, "NVFP4 mesh operands are two E2M1 codes per byte")
+  val dim = meshRows
+  val L = tile_latency + 1
+
+  val m = Module(new NvFp4Mesh(dim, tile_latency))
+
+  for (r <- 0 until dim) m.io.in_a(r) := io.in_a(r)(0).asUInt
+  for (c <- 0 until dim) {
+    val bw = io.in_b(c)(0).asUInt
+    for (k <- 0 until 4) m.io.in_b(c)(k) := bw(16 * k + NvFp4.ColW - 1, 16 * k).asSInt
+    m.io.in_d(c) := io.in_d(c)(0).asUInt
+    m.io.in_prop(c) := io.in_control(c)(0).propagate.asBool
+    m.io.in_valid(c) := io.in_valid(c)(0)
+
+    val ob = Cat((0 until 4).reverse.map(k => m.io.out_b(c)(k).pad(16).asUInt))
+    io.out_b(c)(0) := ShiftRegister(ob, output_delay).asTypeOf(outputType)
+    io.out_valid(c)(0) := ShiftRegister(m.io.out_valid(c), output_delay)
+    io.out_id(c)(0) := ShiftRegister(io.in_id(c)(0), dim * L + output_delay)
+    io.out_last(c)(0) := ShiftRegister(io.in_last(c)(0), dim * L + output_delay)
+    io.out_c(c)(0) := 0.U.asTypeOf(io.out_c(c)(0))
+    io.out_control(c)(0) := 0.U.asTypeOf(io.out_control(c)(0))
+  }
+}
