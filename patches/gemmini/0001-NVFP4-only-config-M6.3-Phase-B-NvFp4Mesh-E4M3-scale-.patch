+import chisel3.util._
+
+/** Decoded E2M1 magnitude (low 3 bits of the code), per the D1 table.
+  * Doubled value = (m3 ? 3 : 1) << k, or 0 when `z`.
+  */
+class Fp4Dec extends Bundle {
+  val m3 = Bool()
+  val k  = UInt(2.W)
+  val z  = Bool()
+}
+
+object NvFp4 {
+  val ColW = 13 // signed column partial-sum width: |sum| <= 16*144 = 2304 < 2^12
+
+  /** code[2:0] = (e[1:0], m). e=0: m'=1,k=0 (zero if m=0); e>=1,m=0: m'=1,k=e; e>=1,m=1: m'=3,k=e-1. */
+  def decode(x: UInt): Fp4Dec = {
+    val e = x(2, 1)
+    val m = x(0)
+    val d = Wire(new Fp4Dec)
+    d.z  := x(2, 0) === 0.U
+    d.m3 := e.orR && m
+    d.k  := Mux(e === 0.U, 0.U, Mux(m, e - 1.U, e))
+    d
+  }
+
+  /** |product| of two decoded operands: mux{1,3,9} << (ka+kb). Max 9<<4 = 144, so 8 bits. */
+  def magProd(a: Fp4Dec, w: Fp4Dec): UInt = {
+    val base = MuxLookup(Cat(a.m3, w.m3), 9.U(4.W))(Seq(0.U -> 1.U(4.W), 1.U -> 3.U(4.W), 2.U -> 3.U(4.W)))
+    val sh   = (base << (a.k +& w.k))(7, 0)
+    Mux(a.z || w.z, 0.U(8.W), sh)
+  }
+
+  /** c + (s ? ~mag : mag) + s as ONE adder with carry-in s: ({c,1} + {x,s}) >> 1.
+    * -0 needs no special case: mag=0, s=1 gives c + (-1) + 1 = c.
+    */
+  def addFold(c: UInt, mag: UInt, s: Bool): UInt = {
+    val m13 = Cat(0.U((ColW - 8).W), mag)
+    val x   = Mux(s, ~m13, m13)
+    val sum = Cat(c, 1.U(1.W)) + Cat(x, s)
+    sum(ColW, 1)
+  }
+}
+
+/** One lane: 4-bit E2M1 x 4-bit E2M1 -> 9-bit signed product of the DOUBLED values (-144..144).
+  * Purely combinational (RawModule: no clock/reset ports); flat port names a, w, p.
+  */
+class NvFp4Mul extends RawModule {
+  val a = IO(Input(UInt(4.W)))
+  val w = IO(Input(UInt(4.W)))
+  val p = IO(Output(SInt(9.W)))
+
+  val mag = NvFp4.magProd(NvFp4.decode(a(2, 0)), NvFp4.decode(w(2, 0)))
+  val s   = a(3) ^ w(3)
+  val m9  = Cat(0.U(1.W), mag)
+  val x   = Mux(s, ~m9, m9)
+  p := (x + s)(8, 0).asSInt
+}
+
+/** 2x2 outer-product PE: d_ij = c_ij + P(a_i, w_j). Each operand is decoded once and shared (variant V6).
+  * Combinational; flat port names match the hand-written Verilog (a0,a1,w0,w1,c00..c11,d00..d11).
+  */
+class NvFp4PE extends RawModule {
+  val a0  = IO(Input(UInt(4.W)))
+  val a1  = IO(Input(UInt(4.W)))
+  val w0  = IO(Input(UInt(4.W)))
+  val w1  = IO(Input(UInt(4.W)))
+  val c00 = IO(Input(SInt(NvFp4.ColW.W)))
+  val c01 = IO(Input(SInt(NvFp4.ColW.W)))
+  val c10 = IO(Input(SInt(NvFp4.ColW.W)))
+  val c11 = IO(Input(SInt(NvFp4.ColW.W)))
+  val d00 = IO(Output(SInt(NvFp4.ColW.W)))
+  val d01 = IO(Output(SInt(NvFp4.ColW.W)))
+  val d10 = IO(Output(SInt(NvFp4.ColW.W)))
+  val d11 = IO(Output(SInt(NvFp4.ColW.W)))
+
+  val da0 = NvFp4.decode(a0(2, 0))
+  val da1 = NvFp4.decode(a1(2, 0))
+  val dw0 = NvFp4.decode(w0(2, 0))
+  val dw1 = NvFp4.decode(w1(2, 0))
+
+  private def lane(c: SInt, da: Fp4Dec, dw: Fp4Dec, sa: Bool, sw: Bool): SInt =
+    NvFp4.addFold(c.asUInt, NvFp4.magProd(da, dw), sa ^ sw).asSInt
+
+  d00 := lane(c00, da0, dw0, a0(3), w0(3))
+  d01 := lane(c01, da0, dw1, a0(3), w1(3))
+  d10 := lane(c10, da1, dw0, a1(3), w0(3))
+  d11 := lane(c11, da1, dw1, a1(3), w1(3))
+}
+
+/** Emit SystemVerilog:  sbt "runMain nvfp4pe.Elaborate <outdir>" */
diff --git a/src/main/scala/gemmini/NvFp4RmwPipe.scala b/src/main/scala/gemmini/NvFp4RmwPipe.scala
new file mode 100644
index 00000000..f63d811f
--- /dev/null
+++ b/src/main/scala/gemmini/NvFp4RmwPipe.scala
@@ -0,0 +1,125 @@
+package gemmini
+
+import chisel3._
+import chisel3.util._
+
+/** Read-modify-write datapath + hazard control for the NVFP4 accumulator (M6.3 Phase B). This is the exact logic that is
+  * ported into Gemmini's AccumulatorMem (NVFP4 branch). The accumulator SRAM itself is outside this module.
+  *
+  * Timeline of one write that fires (`fire`) in cycle t (ScaleLat = 3, AddLat = 2):
+  *   t      : fire; req fields + int13 lanes are registered into pw(0). The scale-factor memory is read in cycle t.
+  *   t+1    : pw(0) valid; scale bytes (sa per entry, sb per lane) arrive; scale-stage stage 0 starts
+  *   t+3    : pw(ScaleLat-1) valid; SRAM read of the OLD accumulator row is issued (rd_en/rd_addr) if acc
+  *   t+4    : scale-stage output (exact FP32 block value) and SRAM read data meet at the adder inputs
+  *   t+6    : adder output (2 stages); pw(L-1), L = 1+ScaleLat+AddLat = 6, is valid; the row (sum, or the block value for a
+  *            non-acc write) is written to the SRAM (wr_*).
+  *
+  * Read-after-write hazard, resolved by STALL (not forwarding): an accumulate to address A whose SRAM read (cycle
+  * t2+ScaleLat) happens before an earlier write to A is in the SRAM (visible from cycle t1+L+1) would read stale data.
+  * That is t2-t1 < L+1-ScaleLat = AddLat+2 = 4, i.e. the earlier write is in pw(0..L-ScaleLat-1). While that is true,
+  * `ready` is low and the producer must hold the request. (Forwarding cannot work: the earlier sum does not exist until
+  * t1+6 but the later add needs it at t1+d+3 with d >= 1, a loop-carried dependency of latency 6, so back-to-back
+  * same-address accumulates have to serialize.) Non-acc writes never read, and write order = fire order (fixed
+  * latency FIFO), so they need no stall.
+  *
+  * `data` carries int13 lanes sign-extended to 16 bits (lane j in bits 16j+15:16j of each entry).
+  */
+class NvFp4RmwPipe(val entries: Int, val lanes: Int = 4, val addrW: Int = 8, val metaW: Int = 1) extends Module {
+  val ScaleLat = 3
+  val AddLat = 2
+  val L = 1 + ScaleLat + AddLat
+  val io = IO(new Bundle {
+    // request side (cycle t)
+    val fire = Input(Bool())
+    val addr = Input(UInt(addrW.W))
+    val acc = Input(Bool())
+    val meta = Input(UInt(metaW.W))
+    val data = Input(Vec(entries, UInt((lanes * 16).W)))
+    val ready = Output(Bool())
+    // scale bytes, valid in cycle t+1 (same cycle pw(0) is valid); sa per lane (Gemmini broadcasts one sa per entry)
+    val sa = Input(Vec(entries, Vec(lanes, UInt(8.W))))
+    val sb = Input(Vec(entries, Vec(lanes, UInt(8.W))))
+    // SRAM read port (1-cycle read latency) and write port
+    val rd_en = Output(Bool())
+    val rd_addr = Output(UInt(addrW.W))
+    val rd_data = Input(Vec(entries, UInt((lanes * 32).W)))
+    val wr_valid = Output(Bool())
+    val wr_addr = Output(UInt(addrW.W))
+    val wr_meta = Output(UInt(metaW.W))
+    val wr_acc = Output(Bool())
+    val wr_data = Output(Vec(entries, UInt((lanes * 32).W)))
+    // in-flight write addresses (pw(0..L-1)) for other hazard checks (mvout reads)
+    val inflight = Output(Vec(L, Valid(UInt(addrW.W))))
+  })
+
+  class Pw extends Bundle { val addr = UInt(addrW.W); val acc = Bool(); val meta = UInt(metaW.W) }
+  val pwV = RegInit(VecInit(Seq.fill(L)(false.B)))
+  val pw = Reg(Vec(L, new Pw))
+  pwV(0) := io.fire
+  pw(0).addr := io.addr; pw(0).acc := io.acc; pw(0).meta := io.meta
+  for (i <- 1 until L) { pwV(i) := pwV(i - 1); pw(i) := pw(i - 1) }
+  for (i <- 0 until L) { io.inflight(i).valid := pwV(i); io.inflight(i).bits := pw(i).addr }
+
+  // ---- RAW hazard: stall an accumulate that would read before an earlier write to the same address lands ----
+  val hazard = io.acc && (0 until (L - ScaleLat)).map(i => pwV(i) && pw(i).addr === io.addr).reduce(_ || _)
+  io.ready := !hazard
+
+  // ---- SRAM read of the old row, ScaleLat cycles after fire ----
+  io.rd_en := pwV(ScaleLat - 1) && pw(ScaleLat - 1).acc
+  io.rd_addr := pw(ScaleLat - 1).addr
+
+  // ---- datapath ----
+  val d0 = RegNext(io.data)
+  val blkOut = Wire(Vec(entries, Vec(lanes, UInt(32.W))))
+  val sumOut = Wire(Vec(entries, Vec(lanes, UInt(32.W))))
+  for (e <- 0 until entries) {
+    val st = Module(new NvFp4ScaleStage(lanes))
+    st.io.in_valid := pwV(0)
+    for (j <- 0 until lanes) {
+      st.io.isum(j) := d0(e)(16 * j + 12, 16 * j).asSInt
+      st.io.sa(j) := io.sa(e)(j)
+      st.io.sb(j) := io.sb(e)(j)
+      val add = Module(new Fp32AccAdd2)
+      add.io.acc := io.rd_data(e)(32 * j + 31, 32 * j)
+      add.io.blk := st.io.out(j)
+      blkOut(e)(j) := ShiftRegister(st.io.out(j), AddLat)
+      sumOut(e)(j) := add.io.sum
+    }
+  }
+  val oldest = pw(L - 1)
+  io.wr_valid := pwV(L - 1)
+  io.wr_addr := oldest.addr
+  io.wr_meta := oldest.meta
+  io.wr_acc := oldest.acc
+  for (e <- 0 until entries)
+    io.wr_data(e) := Mux(oldest.acc, sumOut(e).asUInt, blkOut(e).asUInt)
+}
+
+/** Standalone test wrapper: NvFp4RmwPipe + a flop-array SRAM (depth rows of entries*lanes*32 bits) with a debug read port. */
+class NvFp4AccBank(val entries: Int, val lanes: Int, val depth: Int) extends Module {
+  val aw = log2Ceil(depth)
+  val pipe = Module(new NvFp4RmwPipe(entries, lanes, aw, 1))
+  val io = IO(new Bundle {
+    val fire = Input(Bool())
+    val addr = Input(UInt(aw.W))
+    val acc = Input(Bool())
+    val data = Input(Vec(entries, UInt((lanes * 16).W)))
+    val ready = Output(Bool())
+    val sa = Input(Vec(entries, Vec(lanes, UInt(8.W))))
+    val sb = Input(Vec(entries, Vec(lanes, UInt(8.W))))
+    val wr_valid = Output(Bool())
+    val wr_addr = Output(UInt(aw.W))
+    val wr_data = Output(Vec(entries, UInt((lanes * 32).W)))
+    val dbg_addr = Input(UInt(aw.W))
+    val dbg_data = Output(Vec(entries, UInt((lanes * 32).W)))
+  })
+  pipe.io.fire := io.fire; pipe.io.addr := io.addr; pipe.io.acc := io.acc; pipe.io.meta := 0.U; pipe.io.data := io.data
+  io.ready := pipe.io.ready
+  pipe.io.sa := io.sa; pipe.io.sb := io.sb
+  val mem = Mem(depth, Vec(entries, UInt((lanes * 32).W)))
+  pipe.io.rd_data := RegNext(mem(pipe.io.rd_addr))
+  when(pipe.io.wr_valid) { mem(pipe.io.wr_addr) := pipe.io.wr_data }
+  io.wr_valid := pipe.io.wr_valid; io.wr_addr := pipe.io.wr_addr; io.wr_data := pipe.io.wr_data
+  io.dbg_data := mem(io.dbg_addr)
+}
+
diff --git a/src/main/scala/gemmini/NvFp4ScaleStage.scala b/src/main/scala/gemmini/NvFp4ScaleStage.scala
new file mode 100644
index 00000000..59251c6a
--- /dev/null
+++ b/src/main/scala/gemmini/NvFp4ScaleStage.scala
@@ -0,0 +1,135 @@
+package gemmini
+
+import chisel3._
+import chisel3.util._
+import hardfloat.{AddRecFN, fNFromRecFN, recFNFromFN}
+
+/** NVFP4 block-scale stage (M6.3 Phase A): FP32 bits of  isum * sA * sB  for 4 lanes, exact, 3 register stages.
+  *
+  *  stage 0: decode both E4M3 scales: sP = sigA*sigB (4x4 -> <= 8 bits), eS = eA'+eB' (5 bits), sign, NaN flag
+  *  stage 1: prod = |isum| * sP  (13 x 8 -> 21 bits)
+  *  stage 2: leading-one normalize and pack to FP32, no rounding
+  *
+  * Why nothing rounds: sigA, sigB <= 15 so sP <= 225 (8 bits); |isum| <= 4096 (13-bit magnitude; 2304 in use),
+  * so prod < 2^20 and fits in 21 bits, which is <= 24 (the FP32 significand). The exponent is
+  * eS + 127 - lz in [109, 157]: always a normal FP32, so no overflow and no subnormals either.
+  *
+  * E4M3: e == 0 is subnormal (sig = m, exponent field treated as 1); 0x7F/0xFF are NaN -> the lane outputs the canonical
+  * qNaN 0x7FC00000 (same as refmodel/scale_stage.py). The sign bit of each scale is honoured (sign = sI ^ sA ^ sB,
+  * also for a zero result), although NVFP4 scales are positive.
+  *
+  * Latency: out_valid / out appear 3 cycles after in_valid / lanes (registers after each of the 3 stages).
+  */
+class NvFp4ScaleStage(lanes: Int = 4) extends Module {
+  val io = IO(new Bundle {
+    val in_valid = Input(Bool())
+    val isum = Input(Vec(lanes, SInt(13.W)))
+    val sa = Input(Vec(lanes, UInt(8.W)))
+    val sb = Input(Vec(lanes, UInt(8.W)))
+    val out_valid = Output(Bool())
+    val out = Output(Vec(lanes, UInt(32.W)))
+  })
+
+  private def dec(c: UInt): (UInt, UInt) = { // (significand incl. hidden bit, effective exponent field)
+    val e = c(6, 3); val m = c(2, 0)
+    val sub = e === 0.U
+    (Cat(!sub, m), Mux(sub, 1.U(4.W), e))
+  }
+
+  // ---- stage 0 ----
+  val v0 = RegNext(io.in_valid, false.B)
+  val s0P = Wire(Vec(lanes, UInt(8.W))); val s0E = Wire(Vec(lanes, UInt(5.W)))
+  val s0S = Wire(Vec(lanes, Bool())); val s0N = Wire(Vec(lanes, Bool()))
+  for (i <- 0 until lanes) {
+    val (siga, ea) = dec(io.sa(i)); val (sigb, eb) = dec(io.sb(i))
+    s0P(i) := siga * sigb
+    s0E(i) := ea +& eb
+    s0S(i) := io.sa(i)(7) ^ io.sb(i)(7)
+    s0N(i) := io.sa(i)(6, 0).andR || io.sb(i)(6, 0).andR
+  }
+  val r0P = RegNext(s0P); val r0E = RegNext(s0E); val r0S = RegNext(s0S); val r0N = RegNext(s0N)
+  val r0I = RegNext(io.isum)
+
+  // ---- stage 1 ----
+  val v1 = RegNext(v0, false.B)
+  val s1Prod = Wire(Vec(lanes, UInt(21.W))); val s1S = Wire(Vec(lanes, Bool()))
+  for (i <- 0 until lanes) {
+    val neg = r0I(i) < 0.S
+    val mag = Mux(neg, (-r0I(i)).asUInt, r0I(i).asUInt)(12, 0) // |-4096| = 4096 fits in 13 bits unsigned
+    s1Prod(i) := mag * r0P(i)
+    s1S(i) := r0S(i) ^ neg
+  }
+  val r1Prod = RegNext(s1Prod); val r1E = RegNext(r0E); val r1S = RegNext(s1S); val r1N = RegNext(r0N)
+
+  // ---- stage 2 ----
+  val v2 = RegNext(v1, false.B)
+  val s2 = Wire(Vec(lanes, UInt(32.W)))
+  for (i <- 0 until lanes) {
+    val prod = r1Prod(i)
+    val lz = PriorityEncoder(Reverse(prod))               // 0..20 (don't care when prod == 0)
+    val norm = (prod << lz)(20, 0)                         // leading one at bit 20
+    val frac = Cat(norm(19, 0), 0.U(3.W))                  // 23 bits, exact
+    val expo = (r1E(i) +& 127.U(8.W)) - lz                 // biased exponent, 109..157
+    val zero = prod === 0.U
+    s2(i) := Mux(r1N(i), "h7fc00000".U(32.W),
+      Mux(zero, Cat(r1S(i), 0.U(31.W)), Cat(r1S(i), expo(7, 0), frac)))
+  }
+  io.out := RegNext(s2)
+  io.out_valid := v2
+}
+
+/** FP32 add on recoded (hardfloat) operands: the rounding core only. RNE, no subtraction. */
+class Fp32AccAddRec extends Module {
+  val io = IO(new Bundle {
+    val acc = Input(UInt(33.W))
+    val blk = Input(UInt(33.W))
+    val sum = Output(UInt(33.W))
+  })
+  val add = Module(new AddRecFN(8, 24))
+  add.io.subOp := false.B
+  add.io.a := io.acc
+  add.io.b := io.blk
+  add.io.roundingMode := 0.U // round_near_even
+  add.io.detectTininess := true.B
+  io.sum := add.io.out
+}
+
+/** FP32 add on standard IEEE bit patterns (recode in, add, un-recode out); combinational. NaN out is canonical 0x7FC00000. */
+class Fp32AccAdd extends Module {
+  val io = IO(new Bundle {
+    val acc = Input(UInt(32.W))
+    val blk = Input(UInt(32.W))
+    val sum = Output(UInt(32.W))
+  })
+  val core = Module(new Fp32AccAddRec)
+  core.io.acc := recFNFromFN(8, 24, io.acc)
+  core.io.blk := recFNFromFN(8, 24, io.blk)
+  io.sum := fNFromRecFN(8, 24, core.io.sum)
+}
+
+/** Scale stage + per-lane FP32 accumulator register (one add per K block). `first` starts a new accumulation (acc operand = +0).
+  * Latency: a block poked at cycle t is in `acc` at cycle t+4 (3 scale stages + 1 add). `acc_valid` pulses with it. */
+class NvFp4ScaleAcc(lanes: Int = 4) extends Module {
+  val io = IO(new Bundle {
+    val in_valid = Input(Bool())
+    val first = Input(Bool())
+    val isum = Input(Vec(lanes, SInt(13.W)))
+    val sa = Input(Vec(lanes, UInt(8.W)))
+    val sb = Input(Vec(lanes, UInt(8.W)))
+    val acc_valid = Output(Bool())
+    val acc = Output(Vec(lanes, UInt(32.W)))
+  })
+  val st = Module(new NvFp4ScaleStage(lanes))
+  st.io.in_valid := io.in_valid; st.io.isum := io.isum; st.io.sa := io.sa; st.io.sb := io.sb
+  val f1 = RegNext(io.first); val f2 = RegNext(f1); val f3 = RegNext(f2)
+  val accR = RegInit(VecInit(Seq.fill(lanes)(0.U(32.W))))
+  val adders = Seq.fill(lanes)(Module(new Fp32AccAdd))
+  for (i <- 0 until lanes) {
+    adders(i).io.acc := Mux(f3, 0.U, accR(i))
+    adders(i).io.blk := st.io.out(i)
+    when(st.io.out_valid) { accR(i) := adders(i).io.sum }
+  }
+  io.acc := accR
+  io.acc_valid := RegNext(st.io.out_valid, false.B)
+}
+
