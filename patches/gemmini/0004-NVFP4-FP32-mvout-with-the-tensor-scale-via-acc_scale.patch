From b800fd689a9d8a96dd85b65df55850a43992c542 Mon Sep 17 00:00:00 2001
From: Braedonhansen <braedon.hansen@gmail.com>
Date: Sun, 18 Oct 2026 14:58:09 -0700
Subject: [PATCH 4/4] NVFP4 FP32 mvout with the tensor scale via acc_scale
 (M6.3C)

- AccumulatorScale (use_nvfp4): every DMA read of the accumulator multiplies its 4 x FP32 lanes by the FP32 acc_scale carried by the
  read request (RNE, 2 elastic stages Fp32MulS1/Fp32MulS2 = hardfloat MulRawFN + RoundRawFNToRecFN, ported from hw/nvfp4pe Fp32Mul2),
  before the BF16-mode passthrough of MxRequantizer
- LoopMatmulStCSpad (out_fp32): the spad store's address math doubles for 4-byte elements (chunk 8 rows, j-group 8, row tile, row step)
- MX configs unchanged (generated MX Verilog identical modulo source-line annotations)

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/main/scala/gemmini/AccumulatorScale.scala | 60 ++++++++++++++++++-
 src/main/scala/gemmini/Controller.scala       |  2 +-
 src/main/scala/gemmini/Fp32Mul2.scala         | 57 ++++++++++++++++++
 src/main/scala/gemmini/LoopMatmul.scala       | 19 +++---
 src/main/scala/gemmini/Scratchpad.scala       |  2 +-
 5 files changed, 129 insertions(+), 11 deletions(-)
 create mode 100644 src/main/scala/gemmini/Fp32Mul2.scala

diff --git a/src/main/scala/gemmini/AccumulatorScale.scala b/src/main/scala/gemmini/AccumulatorScale.scala
index d17f443a..aeab0885 100644
--- a/src/main/scala/gemmini/AccumulatorScale.scala
+++ b/src/main/scala/gemmini/AccumulatorScale.scala
@@ -102,7 +102,8 @@ class AccumulatorScale[T <: Data, U <: Data](
   num_scale_units: Int,
   latency: Int,
   has_nonlinear_activations: Boolean, has_normalizations: Boolean,
-  use_mx_scaling: Boolean)(implicit ev: Arithmetic[T]) extends Module {
+  use_mx_scaling: Boolean,
+  use_nvfp4: Boolean = false)(implicit ev: Arithmetic[T]) extends Module {
 
   import ev._
 
@@ -158,12 +159,69 @@ class AccumulatorScale[T <: Data, U <: Data](
       val mx_act_data = if (has_nonlinear_activations)
         VecInit(acc_read_data.map(v => VecInit(v.map(e => Mux(act === Activation.RELU, e.relu, e)))))
       else acc_read_data
+      if (use_nvfp4) {
+        // NVFP4 mvout (M6.3C): every accumulator lane is an IEEE FP32; a DMA read (mvout) multiplies each lane by the FP32
+        // `acc_scale` that rode along with the read request (tensor scale: out = acc * ((tA*tB)*0.25f), computed in software),
+        // RNE, in two elastic stages (Fp32MulS1: recode + MulRawFN; Fp32MulS2: round + un-recode). Non-DMA reads pass
+        // through x 1.0f (exact). The scaled chunk then takes the normal BF16-mode passthrough of MxRequantizer.
+        val nLanes = mx_act_data.length * mx_act_data.head.length * 4
+        class NvMulStage1 extends Bundle {
+          val raw = Vec(nLanes, new hardfloat.RawFloat(8, 26))
+          val invalid = Vec(nLanes, Bool())
+          val fromDMA = Bool()
+          val chunk_id = UInt(GemminiISA.MX_CHUNK_ID_BITS.W)
+          val acc_bank_id = UInt(2.W)
+        }
+        class NvMulStage2 extends Bundle {
+          val data = Vec(nLanes, UInt(32.W))
+          val fromDMA = Bool()
+          val chunk_id = UInt(GemminiISA.MX_CHUNK_ID_BITS.W)
+          val acc_bank_id = UInt(2.W)
+        }
+        val lanes = VecInit(mx_act_data.flatMap(v => v.map(_.asUInt)).flatMap(x => (0 until 4).map(j => x(32 * j + 31, 32 * j))))
+        val scaleBits = io.in.bits.acc_read_resp.scale.asUInt
+        val factor = Mux(io.in.bits.acc_read_resp.fromDMA, scaleBits, "h3f800000".U(32.W))
+        val s1 = Seq.fill(nLanes)(Module(new Fp32MulS1))
+        val in1 = Wire(Decoupled(new NvMulStage1))
+        in1.valid := io.in.valid
+        io.in.ready := in1.ready
+        for (l <- 0 until nLanes) {
+          s1(l).io.a := lanes(l)
+          s1(l).io.b := factor
+          in1.bits.raw(l) := s1(l).io.raw
+          in1.bits.invalid(l) := s1(l).io.invalid
+        }
+        in1.bits.fromDMA := io.in.bits.acc_read_resp.fromDMA
+        in1.bits.chunk_id := io.in.bits.acc_read_resp.chunk_id
+        in1.bits.acc_bank_id := io.in.bits.acc_read_resp.acc_bank_id
+        val out1 = Pipeline(in1, 1)
+        val s2 = Seq.fill(nLanes)(Module(new Fp32MulS2))
+        val in2 = Wire(Decoupled(new NvMulStage2))
+        in2.valid := out1.valid
+        out1.ready := in2.ready
+        for (l <- 0 until nLanes) {
+          s2(l).io.raw := out1.bits.raw(l)
+          s2(l).io.invalid := out1.bits.invalid(l)
+          in2.bits.data(l) := s2(l).io.out
+        }
+        in2.bits.fromDMA := out1.bits.fromDMA
+        in2.bits.chunk_id := out1.bits.chunk_id
+        in2.bits.acc_bank_id := out1.bits.acc_bank_id
+        val out2 = Pipeline(in2, 1)
+        io.mx_req_io.mx_data_in.valid := out2.valid
+        out2.ready := io.mx_req_io.mx_data_in.ready
+        io.mx_req_io.mx_data_in.bits.full_mx_data_in := out2.bits.data.asUInt.asTypeOf(mx_act_data)
+        io.mx_req_io.mx_data_in.bits.fromDMA := out2.bits.fromDMA
+        io.mx_req_io.mx_data_in.bits.chunk_id := out2.bits.chunk_id
+        io.mx_req_io.mx_data_in.bits.acc_bank_id := out2.bits.acc_bank_id
+      } else {
       io.mx_req_io.mx_data_in.valid := io.in.valid
       io.in.ready := io.mx_req_io.mx_data_in.ready
       io.mx_req_io.mx_data_in.bits.full_mx_data_in := mx_act_data
       io.mx_req_io.mx_data_in.bits.fromDMA := io.in.bits.acc_read_resp.fromDMA
       io.mx_req_io.mx_data_in.bits.chunk_id := io.in.bits.acc_read_resp.chunk_id
       io.mx_req_io.mx_data_in.bits.acc_bank_id := io.in.bits.acc_read_resp.acc_bank_id
+      }
       io.mx_req_io.mx_mode := io.output_mx_format
       io.mx_req_io.mx_fp8_altfmt := io.mx_fp8_altfmt
 
