 class LoopMatmulStCSpad(block_size: Int, iterator_bitwidth: Int, max_addr: Int, max_acc_addr: Int,
                         input_w: Int, acc_w: Int, max_block_len: Int, concurrent_loops: Int, tilesPerMxBlock: Int,
-                        mvout_spad_rs1_t: MvoutSpadRs1, mvout_rs2_t: MvoutRs2)
+                        mvout_spad_rs1_t: MvoutSpadRs1, mvout_rs2_t: MvoutRs2, out_fp32: Boolean = false)
                    (implicit p: Parameters) extends Module {
+  // out_fp32 (NVFP4): the BF16-mode spad store carries 4 x FP32 per 128-bit entry, so every spad-row distance derived from the
+  // BF16 layout (2 bytes per element) doubles (4 bytes per element): chunk, j-group, row-tile and row steps.
+  val fp32x = if (out_fp32) 2 else 1
   val io = IO(new Bundle {
     val req = Flipped(Decoupled(new LoopMatmulStCSpadReq(block_size, iterator_bitwidth, max_addr, max_acc_addr, concurrent_loops)))
     val cmd = Decoupled(Output(new RoCCCommand))
@@ -837,7 +840,7 @@ class LoopMatmulStCSpad(block_size: Int, iterator_bitwidth: Int, max_addr: Int,
   // spad-row span = tilesPerMxBlock (mxBlockSize/DIM: 2 at DIM16, 4 at DIM8). Hardcoded 2 only held at DIM16;
   // at DIM=8 a block spans 4 rows so +2 overwrote block0's beats 2-3. Gate on DIM<16 to keep DIM>=16 identical.
   val single_chunk_stride = if (block_size < 16) tilesPerMxBlock else 2
-  val chunk_spad_stride = Mux(req.output_mx_format === 3.U || req.full_c, (2 * tilesPerMxBlock).U,
+  val chunk_spad_stride = Mux(req.output_mx_format === 3.U || req.full_c, (if (out_fp32) 8 else 2 * tilesPerMxBlock).U,
     Mux(req.reuse_tiled && req.output_mx_format === 0.U, (block_size * tilesPerMxBlock).U, single_chunk_stride.U))
 
   val max_blocks = Mux(req.full_c, 1.U, Mux(iter_max_j <= max_block_len.U, iter_max_j, max_block_len.U))
@@ -872,7 +875,7 @@ class LoopMatmulStCSpad(block_size: Int, iterator_bitwidth: Int, max_addr: Int,
     // (mode6/7) H=16 -> i*max_j*block_size*4. The old x8-only assumed quad and doubled the act-single
     // i-stride (tiles i>=1 landed at 2x -> rows>=16 garbage). Gate the height on mx_multi_elem_act.
     // j-term: J-tile = 2*DIM bf16 cols = 4*DIM B = 4 flat spad rows at every DIM.
-    ((req.mx_multi_elem) && (req.output_mx_format === 3.U)) -> ((i*req.max_j)*block_size.U*Mux(req.mx_multi_elem_act, 8.U, 4.U) + j * 4.U)
+    ((req.mx_multi_elem) && (req.output_mx_format === 3.U)) -> ((i*req.max_j)*block_size.U*Mux(req.mx_multi_elem_act, (8 * fp32x).U, (4 * fp32x).U) + j * (4 * fp32x).U)
     ))
   val dst_addr = Mux(!req.mx_multi_elem,
     req.dst_addr + dst_offset + chunk_id * chunk_spad_stride,
@@ -904,7 +907,7 @@ class LoopMatmulStCSpad(block_size: Int, iterator_bitwidth: Int, max_addr: Int,
   val st_wide = req.output_mx_format === 3.U
   val st_row_step = Mux(req.reuse_tiled, 1.U,
     Mux(st_wide && !req.mx_multi_elem, st_j / 2.U * 4.U,
-      Mux(st_wide, st_j * Mux(req.mx_multi_elem_act, 8.U, 4.U),
+      Mux(st_wide, st_j * Mux(req.mx_multi_elem_act, (8 * fp32x).U, (4 * fp32x).U),
         Mux(!req.mx_multi_elem, st_j / 2.U * 2.U, st_j * 2.U))))
   mvout_cmd_rs1.stride := (BigInt(1) << 31).U | st_row_step.pad(31)
   mvout_cmd.rs1 := mvout_cmd_rs1.asUInt
@@ -1100,7 +1103,7 @@ class LoopMatmul(block_size: Int, coreMaxAddrBits: Int, reservation_station_size
                  max_addr: Int, max_acc_addr: Int, input_w: Int, acc_w: Int, dma_max_bytes: Int,
                  mvin_rs2_t: MvinRs2, preload_rs1_t: PreloadRs, preload_rs2_t: PreloadRs,
                  compute_rs1_t: ComputeRs, compute_rs2_t: ComputeRs, mvout_spad_rs1_t: MvoutSpadRs1, mvout_rs2_t: MvoutRs2,
-                 vec_bypass: Boolean = false, scale_size: Int = 32)
+                 vec_bypass: Boolean = false, scale_size: Int = 32, out_fp32: Boolean = false)
                 (implicit p: Parameters) extends Module {
   val iterator_bitwidth = 16
   // k-tiles per scale block: scale_size / DIM (MX: 32/16 = 2; NVFP4: scaleSize 16 -> 1)
@@ -1159,7 +1162,7 @@ class LoopMatmul(block_size: Int, coreMaxAddrBits: Int, reservation_station_size
   val ex = Module(new LoopMatmulExecute(block_size, coreMaxAddrBits, iterator_bitwidth, max_addr, max_acc_addr, concurrent_loops, preload_rs1_t, preload_rs2_t, compute_rs1_t, compute_rs2_t))
   // max_block_len 1 (as stC_spad): an MX mvout covers one 4-tile j-group; wider would skip groups.
   val stC = Module(new LoopMatmulStC(block_size, coreMaxAddrBits, iterator_bitwidth, max_acc_addr, input_w, acc_w, 1, concurrent_loops, tilesPerMxBlock, mvout_rs2_t))
-  val stC_spad = Module(new LoopMatmulStCSpad(block_size, iterator_bitwidth, max_addr, max_acc_addr, input_w, acc_w, 1, concurrent_loops, tilesPerMxBlock, mvout_spad_rs1_t, mvout_rs2_t))
+  val stC_spad = Module(new LoopMatmulStCSpad(block_size, iterator_bitwidth, max_addr, max_acc_addr, input_w, acc_w, 1, concurrent_loops, tilesPerMxBlock, mvout_spad_rs1_t, mvout_rs2_t, out_fp32))
 
   // Create command queue
   val cmd = Queue(io.in)
@@ -1759,11 +1762,11 @@ object LoopMatmul {
